# ---------------------------------------------------------------------------
# Zepp / Huami API
# ---------------------------------------------------------------------------

APP_TOKEN="yourverylongtoken"

# API-Region:
# Deutschland bzw. Europa in der Regel api-mifit-de2.huami.com
HUAMI_BASE_URL=https://api-mifit-de2.huami.com/v1/sport/run
HUAMI_ACTIVITY_SOURCE=run.fit.huami.com

# ---------------------------------------------------------------------------
# Verzeichnisse
# ---------------------------------------------------------------------------

DOWNLOAD_PATH=./watch
LOG_PATH=./logs
# Pfad zur Datei, in der die heruntergeladenen IDs gespeichert werden
HISTORY_FILE=./download_history.txt
# ---------------------------------------------------------------------------
# Abruf
# ---------------------------------------------------------------------------

# Anzahl der neuesten Aktivitäten, die bei jedem Lauf geprüft werden
FETCH_LIMIT=20

# Pause zwischen den Detail-Abfragen in Sekunden
REQUEST_DELAY=1

# HTTP-Timeout in Sekunden
REQUEST_TIMEOUT=30

# Wiederholungsversuche bei temporären Netzwerkfehlern
MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

LOG_LEVEL=INFO

# Maximale Größe einer Logdatei in Bytes
# 5.242.880 Bytes entsprechen 5 MiB
LOG_MAX_BYTES=5242880

# Anzahl der alten Logdateien
# zepp_downloader.log.1 bis zepp_downloader.log.5
LOG_BACKUP_COUNT=2
